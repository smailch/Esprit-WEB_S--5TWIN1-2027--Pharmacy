# Copier en .env (jamais commité). Aucune clé API n'est nécessaire.

# rdflib = graphe en mémoire (aucun service à lancer) ; fuseki = Apache Jena Fuseki
SPARQL_BACKEND=rdflib
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=pharma
FUSEKI_USER=admin
FUSEKI_PASSWORD=admin

CORS_ORIGINS=http://localhost:5173

# Le backend écoute sur le port 8001 (le 8000 est pris par le backend du module A).
# Le proxy Vite du projet racine redirige /api-ahmed vers http://127.0.0.1:8001
# (modifiable par la variable d'environnement VITE_AHMED_BACKEND_URL).
